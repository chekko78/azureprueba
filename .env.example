# Copia este archivo como .env y llena tus datos. NUNCA subas .env a git.

# Servidor de Azure SQL (Portal -> Base de datos -> Información general)
AZURE_SQL_SERVER=miservidor.database.windows.net
AZURE_SQL_DATABASE=test
AZURE_SQL_PORT=1433

# Autenticación:
#   sql   -> usuario y contraseña SQL (lo más simple para probar)
#   entra -> Microsoft Entra ID / Identidad administrada (recomendado en producción)
AZURE_SQL_AUTH=sql

# Solo si AZURE_SQL_AUTH=sql
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# Driver ODBC instalado en tu equipo (en Azure App Service Linux ya viene el 18)
ODBC_DRIVER=ODBC Driver 18 for SQL Server
